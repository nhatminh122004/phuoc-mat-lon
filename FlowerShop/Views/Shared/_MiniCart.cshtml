@model FlowerShop.Models.ViewModels.ShoppingCart

<div class="cart-drawer-header">
    <h3 class="cart-drawer-title font-serif">Giỏ Hoa Của Bạn (@Model.TotalItemsCount)</h3>
    <button type="button" class="btn-close-drawer" id="cartCloseBtn">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>

<div class="cart-drawer-body">
    @if (!Model.Items.Any())
    {
        <div style="text-align: center; padding: 40px 0;">
            <i class="fa-solid fa-basket-shopping" style="font-size: 3rem; color: #e6dbdd; margin-bottom: 16px;"></i>
            <p style="color: #888; margin-bottom: 20px;">Giỏ hàng của bạn đang trống.</p>
            <a href="/Product" class="btn btn-primary btn-sm">Khám Phá Hoa Tươi</a>
        </div>
    }
    else
    {
        <!-- Free Shipping Progress -->
        <div class="cart-free-shipping-progress">
            @if (Model.SubTotal + Model.AddonTotal >= 500000)
            {
                <div style="color: #2e7d32; font-weight: 600;">
                    <i class="fa-solid fa-circle-check"></i> Bạn đã được <strong>Miễn phí giao hoa</strong>!
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: 100%;"></div>
                </div>
            }
            else
            {
                decimal remaining = 500000 - (Model.SubTotal + Model.AddonTotal);
                double pct = (double)((Model.SubTotal + Model.AddonTotal) / 500000m) * 100;
                <div>
                    Mua thêm <strong>@remaining.ToString("N0") đ</strong> để được <strong>Miễn phí giao hàng</strong>!
                </div>
                <div class="progress-bar-bg">
                    <div class="progress-bar-fill" style="width: @pct%;"></div>
                </div>
            }
        </div>

        <!-- Items List -->
        <div style="display: flex; flex-direction: column; gap: 14px;">
            @foreach (var item in Model.Items)
            {
                <div style="display: flex; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid #f2e6e8; align-items: center;">
                    <img src="@item.ImageUrl" style="width: 60px; height: 60px; border-radius: 8px; object-fit: cover;" />
                    <div style="flex: 1;">
                        <a href="/hoa/@item.ProductSlug" style="font-weight: 600; font-size: 0.9rem; color: #2e2426; display: block; line-height: 1.3;">@item.ProductName</a>
                        <div style="color: var(--primary); font-weight: 700; font-size: 0.85rem; margin-top: 4px;">
                            @item.UnitPrice.ToString("N0") đ x @item.Quantity
                        </div>
                    </div>
                    <form action="/Cart/RemoveItem" method="post" style="margin: 0;">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" style="background: none; border: none; color: #b5a9ab; cursor: pointer; font-size: 0.9rem;" title="Xóa">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                    </form>
                </div>
            }

            @if (Model.Addons.Any())
            {
                <div style="font-size: 0.82rem; font-weight: 700; color: #888; text-transform: uppercase; margin-top: 8px;">Quà tặng kèm:</div>
                foreach (var addon in Model.Addons)
                {
                    <div style="display: flex; gap: 10px; align-items: center; background: #faf5f6; padding: 6px 10px; border-radius: 8px;">
                        <img src="@addon.ImageUrl" style="width: 36px; height: 36px; border-radius: 6px; object-fit: cover;" />
                        <div style="flex: 1; font-size: 0.82rem;">
                            <strong>@addon.AddonName</strong>
                            <span style="color: var(--primary);">(@addon.UnitPrice.ToString("N0") đ)</span>
                        </div>
                        <form action="/Cart/RemoveAddon" method="post" style="margin: 0;">
                            <input type="hidden" name="addonId" value="@addon.AddonId" />
                            <button type="submit" style="background: none; border: none; color: #b5a9ab; cursor: pointer;">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </form>
                    </div>
                }
            }
        </div>
    }
</div>

@if (Model.Items.Any())
{
    <div class="cart-drawer-footer">
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.95rem;">
            <span>Tạm tính hoa:</span>
            <strong>@Model.SubTotal.ToString("N0") đ</strong>
        </div>
        @if (Model.AddonTotal > 0)
        {
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.9rem; color: #666;">
                <span>Phụ kiện quà:</span>
                <span>+@Model.AddonTotal.ToString("N0") đ</span>
            </div>
        }
        @if (Model.DiscountAmount > 0)
        {
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.9rem; color: #2e7d32;">
                <span>Ưu đãi (@Model.AppliedVoucher.Code):</span>
                <span>-@Model.DiscountAmount.ToString("N0") đ</span>
            </div>
        }
        <div style="display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 1.15rem; font-weight: 700; color: var(--primary); border-top: 1px solid #e9dbde; padding-top: 10px;">
            <span>Tổng cộng:</span>
            <span>@Model.TotalAmount.ToString("N0") đ</span>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="/Cart" class="btn btn-secondary" style="flex: 1; padding: 12px; font-size: 0.9rem;">Xem Giỏ Hàng</a>
            <a href="/Checkout" class="btn btn-primary" style="flex: 1; padding: 12px; font-size: 0.9rem;">Đặt Hàng Ngay</a>
        </div>
    </div>
}
