@model FlowerShop.Models.ViewModels.ShoppingCart
@{
    ViewBag.Title = "Giỏ Hàng - Bloom & Grace";
}

<div class="section" style="padding-top: 40px;">
    <h1 class="font-serif" style="font-size: 2.2rem; margin-bottom: 24px; color: var(--dark);">Giỏ Hoa Của Bạn</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #e8f5e9; color: #2e7d32; padding: 14px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: 600;">
            <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background: #ffebee; color: #c62828; padding: 14px 20px; border-radius: 12px; margin-bottom: 20px; font-weight: 600;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div style="text-align: center; padding: 80px 20px; background: #fff; border-radius: 20px; border: 1px solid var(--border);">
            <i class="fa-solid fa-basket-shopping" style="font-size: 4rem; color: #eedfe2; margin-bottom: 20px;"></i>
            <h3 class="font-serif" style="margin-bottom: 10px;">Giỏ hàng của bạn đang trống</h3>
            <p style="color: var(--text-muted); margin-bottom: 24px;">Hãy chọn cho mình hoặc người thân một tác phẩm hoa tươi rạng rỡ nhất nhé!</p>
            <a href="/Product" class="btn btn-primary">Khám Phá Hoa Tươi Ngay</a>
        </div>
    }
    else
    {
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px; align-items: start;">
            <!-- Left: Items Table -->
            <div style="background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-sm);">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border); text-align: left;">
                            <th style="padding-bottom: 14px; font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted);">Sản Phẩm</th>
                            <th style="padding-bottom: 14px; font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); text-align: center;">Số Lượng</th>
                            <th style="padding-bottom: 14px; font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); text-align: right;">Thành Tiền</th>
                            <th style="padding-bottom: 14px; width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr style="border-bottom: 1px solid #f6eff0;">
                                <td style="padding: 16px 0; display: flex; gap: 14px; align-items: center;">
                                    <img src="@item.ImageUrl" style="width: 70px; height: 70px; border-radius: 10px; object-fit: cover;" />
                                    <div>
                                        <a href="/hoa/@item.ProductSlug" style="font-weight: 600; font-size: 0.95rem; color: #2e2426; display: block;">@item.ProductName</a>
                                        <span style="color: var(--primary); font-weight: 700; font-size: 0.88rem;">@item.UnitPrice.ToString("N0") đ</span>
                                    </div>
                                </td>
                                <td style="padding: 16px 0; text-align: center;">
                                    <form action="/Cart/UpdateQuantity" method="post" style="display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: 20px; padding: 2px 8px;">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" name="quantity" value="@(item.Quantity - 1)" style="background: none; border: none; cursor: pointer; padding: 4px 6px;">-</button>
                                        <span style="font-weight: 700; min-width: 24px;">@item.Quantity</span>
                                        <button type="submit" name="quantity" value="@(item.Quantity + 1)" style="background: none; border: none; cursor: pointer; padding: 4px 6px;">+</button>
                                    </form>
                                </td>
                                <td style="padding: 16px 0; text-align: right; font-weight: 700; color: #2e2426;">
                                    @item.TotalPrice.ToString("N0") đ
                                </td>
                                <td style="padding: 16px 0; text-align: right;">
                                    <form action="/Cart/RemoveItem" method="post" style="margin: 0;">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" style="background: none; border: none; color: #b5a9ab; cursor: pointer; font-size: 1rem;"><i class="fa-regular fa-trash-can"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (Model.Addons.Any())
                        {
                            <tr>
                                <td colspan="4" style="padding-top: 18px; font-weight: 700; font-size: 0.85rem; color: #888; text-transform: uppercase;">Quà Tặng Kèm Theo:</td>
                            </tr>
                            foreach (var addon in Model.Addons)
                            {
                                <tr style="border-bottom: 1px solid #f6eff0;">
                                    <td style="padding: 10px 0; display: flex; gap: 12px; align-items: center;">
                                        <img src="@addon.ImageUrl" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover;" />
                                        <div>
                                            <span style="font-weight: 600; font-size: 0.88rem;">@addon.AddonName</span>
                                            <span style="color: var(--primary); font-size: 0.82rem; margin-left: 6px;">(@addon.UnitPrice.ToString("N0") đ)</span>
                                        </div>
                                    </td>
                                    <td style="text-align: center; font-weight: 600;">x @addon.Quantity</td>
                                    <td style="text-align: right; font-weight: 700;">@addon.TotalPrice.ToString("N0") đ</td>
                                    <td style="text-align: right;">
                                        <form action="/Cart/RemoveAddon" method="post" style="margin: 0;">
                                            <input type="hidden" name="addonId" value="@addon.AddonId" />
                                            <button type="submit" style="background: none; border: none; color: #b5a9ab; cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Right: Voucher & Order Summary -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Voucher Box -->
                <div style="background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 20px; box-shadow: var(--shadow-sm);">
                    <h4 style="font-size: 0.95rem; margin-bottom: 12px; font-weight: 700;"><i class="fa-solid fa-ticket" style="color: var(--primary); margin-right: 6px;"></i> Mã Ưu Đãi / Voucher:</h4>
                    <form action="/Cart/ApplyVoucher" method="post" style="display: flex; gap: 8px;">
                        <input type="text" name="code" placeholder="Nhập mã (VD: WELCOME50, BLOOM10)" value="@(Model.AppliedVoucher?.Code)" style="flex: 1; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 0.88rem; outline: none; text-transform: uppercase;" />
                        <button type="submit" class="btn btn-secondary btn-sm" style="padding: 10px 16px;">Áp Dụng</button>
                    </form>
                    <div style="font-size: 0.78rem; color: #888; margin-top: 8px;">Gợi ý mã: <strong>WELCOME50</strong> (giảm 50k), <strong>BLOOM10</strong> (giảm 10%)</div>
                </div>

                <!-- Summary Box -->
                <div style="background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 24px; box-shadow: var(--shadow-sm);">
                    <h3 class="font-serif" style="font-size: 1.25rem; margin-bottom: 18px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">Đơn Hàng Tạm Tính</h3>

                    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.92rem;">
                        <span style="color: var(--text-muted);">Tạm tính hoa:</span>
                        <strong>@Model.SubTotal.ToString("N0") đ</strong>
                    </div>
                    @if (Model.AddonTotal > 0)
                    {
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.92rem;">
                            <span style="color: var(--text-muted);">Phụ kiện:</span>
                            <strong>+@Model.AddonTotal.ToString("N0") đ</strong>
                        </div>
                    }
                    @if (Model.DiscountAmount > 0)
                    {
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.92rem; color: #2e7d32;">
                            <span>Mã giảm giá (@Model.AppliedVoucher.Code):</span>
                            <strong>-@Model.DiscountAmount.ToString("N0") đ</strong>
                        </div>
                    }
                    <div style="display: flex; justify-content: space-between; margin-bottom: 18px; font-size: 0.92rem;">
                        <span style="color: var(--text-muted);">Phí giao hoa:</span>
                        <span>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + " đ")</span>
                    </div>

                    <div style="display: flex; justify-content: space-between; font-size: 1.3rem; font-weight: 700; color: var(--primary); border-top: 1px solid var(--border); padding-top: 14px; margin-bottom: 24px;">
                        <span>Tổng Cộng:</span>
                        <span>@Model.TotalAmount.ToString("N0") đ</span>
                    </div>

                    <a href="/Checkout" class="btn btn-primary" style="width: 100%; padding: 14px; font-size: 1rem;">
                        Tiến Hành Thanh Toán <i class="fa-solid fa-arrow-right-long"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>
