@{
    ViewBag.Title = "Đăng Nhập - Hữu Phước Florist";
    var returnUrl = ViewBag.ReturnUrl as string ?? Request.QueryString["returnUrl"] ?? "";
    var authError = ViewBag.AuthError as string;
}

<section class="auth-page-section">
    <div class="auth-card">
        <div class="auth-header">
            <a href="/" class="auth-logo">
                <i class="fa-solid fa-spa"></i>
                <span>Hữu Phước<strong>Florist</strong></span>
            </a>
            <h1 class="auth-title font-serif">Chào mừng trở lại</h1>
            <p class="auth-subtitle">Đăng nhập để theo dõi tiến độ bó hoa, quản lý ưu đãi và đặt hoa hỏa tốc dễ dàng hơn.</p>
        </div>

        <!-- Feedback Alert Container -->
        <div id="loginAlert" class="auth-alert @(string.IsNullOrEmpty(authError) ? "" : "auth-alert-error")" style="@(string.IsNullOrEmpty(authError) ? "display:none;" : "display:flex;")">
            @if (!string.IsNullOrEmpty(authError))
            {
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@authError</span>
            }
        </div>

        <form id="loginForm" action="/Account/Login" method="post" onsubmit="BloomAuth.handleLogin(event)">
    @Html.AntiForgeryToken()
            <input type="hidden" id="loginReturnUrl" name="returnUrl" value="@returnUrl" />

            <!-- Email or Username Input -->
            <div class="form-group">
                <label class="form-label" for="loginEmail">Email hoặc Tên đăng nhập</label>
                <div class="input-with-icon">
                    <input type="text" id="loginEmail" name="email" class="form-control" placeholder="nhapemail@domain.com hoặc admin" autocomplete="username" />
                    <i class="fa-regular fa-envelope input-icon"></i>
                </div>
            </div>

            <!-- Password Input -->
            <div class="form-group">
                <label class="form-label" for="loginPassword">Mật khẩu</label>
                <div class="input-with-icon">
                    <input type="password" id="loginPassword" name="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    <i class="fa-solid fa-lock input-icon"></i>
                    <button type="button" class="password-toggle-btn" onclick="BloomAuth.togglePassword('loginPassword', this)" title="Hiện/ẩn mật khẩu">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
            </div>

            <!-- Remember me & Forgot Password -->
            <div class="form-options">
                <label class="checkbox-label">
                    <input type="checkbox" id="rememberMe" name="rememberMe" value="true" checked />
                    <span>Ghi nhớ đăng nhập</span>
                </label>
                <a href="/Account/ForgotPassword" class="auth-link">Quên mật khẩu?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="loginSubmitBtn" class="btn btn-primary btn-auth">
                <i class="fa-solid fa-arrow-right-to-bracket"></i> Đăng Nhập
            </button>
        </form>

        <div class="auth-footer">
            <span>Chưa có tài khoản?</span>
            <a href="/Account/Register" class="auth-link" style="margin-left: 6px;">Đăng ký ngay</a>
        </div>
    </div>
</section>
