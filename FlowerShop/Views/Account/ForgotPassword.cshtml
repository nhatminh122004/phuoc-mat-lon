@model FlowerShop.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên Mật Khẩu - Hữu Phước Florist";
    bool hasOutcome = ViewBag.OutcomeMessage != null;
    bool outcomeSuccess = ViewBag.OutcomeSuccess != null && (bool)ViewBag.OutcomeSuccess;
    string devResetUrl = ViewBag.DevResetUrl as string;
}

<section class="auth-page-section">
    <div class="auth-card">
        <div class="auth-header">
            <div style="width: 68px; height: 68px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 18px;">
                <i class="fa-solid fa-key"></i>
            </div>
            <h1 class="auth-title font-serif">Khôi phục mật khẩu</h1>
            <p class="auth-subtitle">
                Nhập email đã đăng ký, chúng tôi sẽ gửi cho bạn một liên kết đặt lại mật khẩu.
                Liên kết chỉ dùng được một lần và hết hạn sau 30 phút.
            </p>
        </div>

        <div id="forgotAlert" class="auth-alert @(hasOutcome ? (outcomeSuccess ? "auth-alert-success" : "auth-alert-error") : "")">
            @if (hasOutcome)
            {
                <i class="fa-solid @(outcomeSuccess ? "fa-circle-check" : "fa-circle-exclamation")"></i> <span>@ViewBag.OutcomeMessage</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(devResetUrl))
        {
            <div style="background:#fffbeb;border:1px dashed #f59e0b;color:#92400e;padding:12px 16px;border-radius:10px;font-size:0.82rem;margin-bottom:16px;word-break:break-all;">
                <strong>Chế độ dev:</strong> SMTP chưa cấu hình nên mail được ghi vào <code>App_Data/emails</code>.
                <a href="@devResetUrl" style="color:#b45309;font-weight:700;">Mở link đặt lại mật khẩu</a>
            </div>
        }

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgotForm", onsubmit = "return BloomAuth.handleForgotPassword(event);" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label" for="forgotEmail">Địa chỉ Email đã đăng ký *</label>
                <div class="input-with-icon">
                    <input type="email" id="forgotEmail" name="email" value="@Model.Email" class="form-control" placeholder="nhapemail@domain.com" autocomplete="email" required />
                    <i class="fa-regular fa-envelope input-icon"></i>
                </div>
            </div>

            <button type="submit" id="forgotSubmitBtn" class="btn btn-primary btn-auth" style="margin-top: 10px;">
                <i class="fa-solid fa-paper-plane"></i> Gửi link đặt lại mật khẩu
            </button>
        }

        <div class="auth-footer" style="display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap;">
            <a href="/Account/Login" class="auth-link">
                <i class="fa-solid fa-arrow-left" style="margin-right: 6px;"></i> Quay lại Đăng nhập
            </a>
            <a href="/Account/ResetPassword" class="auth-link">
                Đã có link? <strong>Đặt lại ngay</strong>
            </a>
        </div>
    </div>
</section>
