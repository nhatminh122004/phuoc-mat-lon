@model FlowerShop.Models.ViewModels.ResetPasswordViewModel
@{
    ViewBag.Title = "Đặt Lại Mật Khẩu - Hữu Phước Florist";
    string errorMessage = ViewBag.ErrorMessage as string;
}

<section class="auth-page-section">
    <div class="auth-card">
        <div class="auth-header">
            <div style="width: 68px; height: 68px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 18px;">
                <i class="fa-solid fa-lock-open"></i>
            </div>
            <h1 class="auth-title font-serif">Đặt lại mật khẩu</h1>
            <p class="auth-subtitle">Mật khẩu mới cần tối thiểu 8 ký tự và bao gồm cả chữ lẫn số.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="auth-alert auth-alert-error">
                <i class="fa-solid fa-circle-exclamation"></i> <span>@errorMessage</span>
            </div>
        }

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Token)

            <div class="form-group">
                <label class="form-label" for="resetPassword">Mật khẩu mới *</label>
                <div class="input-with-icon">
                    @Html.PasswordFor(m => m.Password, new { id = "resetPassword", @class = "form-control", placeholder = "Tối thiểu 8 ký tự, có chữ và số", autocomplete = "new-password", required = "required" })
                    <i class="fa-solid fa-lock input-icon"></i>
                    <button type="button" class="password-toggle-btn" onclick="BloomAuth.togglePassword('resetPassword', this)" title="Hiện/ẩn mật khẩu">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="resetConfirmPassword">Xác nhận mật khẩu *</label>
                <div class="input-with-icon">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { id = "resetConfirmPassword", @class = "form-control", placeholder = "Nhập lại mật khẩu mới", autocomplete = "new-password", required = "required" })
                    <i class="fa-solid fa-lock input-icon"></i>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-auth" style="margin-top: 10px;">
                <i class="fa-solid fa-check"></i> Cập nhật mật khẩu
            </button>
        }

        <div class="auth-footer">
            <a href="/Account/Login" class="auth-link">
                <i class="fa-solid fa-arrow-left" style="margin-right: 6px;"></i> Quay lại Đăng nhập
            </a>
        </div>
    </div>
</section>
