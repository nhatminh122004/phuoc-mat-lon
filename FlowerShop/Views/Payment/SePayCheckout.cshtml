@model FlowerShop.Services.SePay.SePayCheckoutForm
@{
    ViewBag.Title = "Đang chuyển tới cổng thanh toán SePay - Hữu Phước Florist";
}

<div class="section" style="padding-top: 70px; max-width: 620px; text-align: center;">
    <div style="background: #fff; border: 1px solid var(--border); border-radius: 24px; padding: 40px; box-shadow: var(--shadow-md);">
        <div style="width: 70px; height: 70px; border-radius: 50%; background: #e3f2fd; color: #1565c0; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 20px;">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <h1 class="font-serif" style="font-size: 1.7rem; margin-bottom: 8px;">Đang chuyển tới SePay…</h1>
        <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7;">
            Bạn sẽ được đưa sang trang thanh toán an toàn của <strong>SePay</strong> để quét QR ngân hàng,
            thẻ ATM/NAPAS hoặc thẻ quốc tế.<br />
            Vui lòng không đóng trình duyệt.
        </p>

        <p style="font-size: 0.85rem; color: var(--text-muted);">
            Mã đơn: <strong>@Model.InvoiceNumber</strong>
        </p>

        <form id="sePayForm" action="@Model.ActionUrl" method="POST" style="margin-top: 22px;">
            @foreach (var field in Model.Fields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <button type="submit" class="btn btn-primary" style="padding: 13px 28px;">
                <i class="fa-solid fa-arrow-right-long"></i> Thanh toán ngay
            </button>
        </form>

        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 18px;">
            Không tự chuyển trang? Bấm nút phía trên, hoặc
            <a href="/tra-cuu-don-hang?orderCode=@Model.InvoiceNumber" style="color: var(--primary);">xem đơn hàng</a>.
        </p>
    </div>
</div>

@section scripts {
    <script>
        // Tự submit ngay khi trang load (form POST bắt buộc, không dùng GET)
        (function () {
            var form = document.getElementById('sePayForm');
            if (form) {
                setTimeout(function () { form.submit(); }, 350);
            }
        })();
    </script>
}
