@{
    ViewBag.Title = "Thanh Toán Không Thành Công - Bloom & Grace";
}

<div class="section" style="padding-top: 50px; max-width: 650px; text-align: center;">
    <div style="background: #fff; border: 1px solid var(--border); border-radius: 24px; padding: 48px 40px; box-shadow: var(--shadow-md);">
        <div style="width: 80px; height: 80px; border-radius: 50%; background: #ffebee; color: #c62828; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 24px;">
            <i class="fa-solid fa-circle-exclamation"></i>
        </div>

        <h1 class="font-serif" style="font-size: 2rem; margin-bottom: 12px; color: var(--dark);">Thanh Toán Không Thành Công</h1>
        <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 30px;">
            @(ViewBag.Message ?? "Giao dịch thanh toán chưa thể hoàn tất. Quý khách vui lòng thử lại hoặc chọn phương thức thanh toán khác.")
        </p>

        <div style="display: flex; gap: 14px; justify-content: center;">
            <a href="/Checkout" class="btn btn-primary">
                Thử Lại Thanh Toán
            </a>
            <a href="/" class="btn btn-secondary">
                Về Trang Chủ
            </a>
        </div>
    </div>
</div>
