@model FlowerShop.Models.Entities.Order
@{
    ViewBag.Title = "Đặt Hàng Thành Công - Hữu Phước Florist";
}

<div class="section" style="padding-top: 50px; max-width: 780px;">
    <div style="background: #fff; border: 1px solid var(--border); border-radius: 24px; padding: 48px 40px; box-shadow: var(--shadow-md); text-align: center;">
        
        <div style="width: 80px; height: 80px; border-radius: 50%; background: #e8f5e9; color: #2e7d32; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 24px;">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <span style="color: var(--primary); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Trao Gửi Yêu Thương Thành Công</span>
        <h1 class="font-serif" style="font-size: 2.2rem; margin: 8px 0 16px; color: var(--dark);">Cảm Ơn Bạn Đã Đặt Hoa!</h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 32px;">
            Đơn hoa <strong>#@Model.OrderCode</strong> đã được tiếp nhận. Nghệ nhân cắm hoa sẽ bắt đầu chuẩn bị tác phẩm tươi đẹp nhất cho bạn.
        </p>

        <!-- Order Summary Card -->
        <div style="background: var(--bg-body); border-radius: 16px; padding: 24px; text-align: left; margin-bottom: 32px; font-size: 0.92rem; line-height: 1.8;">
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e8dbde; padding-bottom: 10px; margin-bottom: 10px;">
                <span style="color: var(--text-muted);">Mã đơn hàng:</span>
                <strong style="font-size: 1.05rem; color: var(--primary);">@Model.OrderCode</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Người nhận hoa:</span>
                <strong>@Model.RecipientName (@Model.RecipientPhone)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Địa chỉ giao hoa:</span>
                <span>@Model.RecipientAddress, @Model.District, @Model.City</span>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Thời gian giao:</span>
                <strong style="color: #2e7d32;">@Model.DeliveryDate.ToString("dd/MM/yyyy") (@Model.DeliveryTimeSlot)</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Phương thức thanh toán:</span>
                <span>@Model.PaymentMethod (@Model.PaymentStatus)</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.CardMessage))
            {
                <div style="border-top: 1px solid #e8dbde; padding-top: 10px; margin-top: 10px;">
                    <span style="color: var(--text-muted); display: block; margin-bottom: 4px;">Lời chúc thiệp:</span>
                    <em style="color: #555; background: #fff; padding: 8px 12px; border-radius: 8px; display: block;">"@Model.CardMessage"</em>
                </div>
            }
            <div style="display: flex; justify-content: space-between; border-top: 1px solid #e8dbde; padding-top: 10px; margin-top: 10px; font-size: 1.15rem; font-weight: 700; color: var(--primary);">
                <span>Tổng giá trị đơn:</span>
                <span>@Model.TotalAmount.ToString("N0") đ</span>
            </div>
        </div>

        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a href="/tra-cuu-don-hang?orderCode=@Model.OrderCode" class="btn btn-primary">
                <i class="fa-solid fa-truck-ramp-box"></i> Theo Dõi Tiến Độ Đơn & Xem Ảnh Hoa
            </a>
            <a href="/" class="btn btn-secondary">
                Về Trang Chủ
            </a>
        </div>
    </div>
</div>
