@model FlowerShop.Models.Entities.Order
@{
    ViewBag.Title = "Quét QR chuyển khoản SePay - Hữu Phước Florist";
    bool isSandbox = ViewBag.IsSandbox != null && (bool)ViewBag.IsSandbox;
}

<div class="section" style="padding-top: 50px; max-width: 820px; text-align: center;">
    <div style="background: #fff; border: 1px solid var(--border); border-radius: 24px; padding: 40px; box-shadow: var(--shadow-md);">
        <div style="width: 70px; height: 70px; border-radius: 50%; background: #ecfdf5; color: #047857; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 20px;">
            <i class="fa-solid fa-qrcode"></i>
        </div>

        <h1 class="font-serif" style="font-size: 2rem; margin-bottom: 8px;">Quét QR để thanh toán</h1>
        <p style="color: var(--text-muted); margin-bottom: 22px;">
            Mở app ngân hàng bất kỳ → quét mã bên dưới. Số tiền và nội dung chuyển khoản đã được điền sẵn.
        </p>

        @if (isSandbox)
        {
            <div style="display:inline-block;background:#fffbeb;color:#92400e;border:1px dashed #f59e0b;border-radius:10px;padding:8px 14px;font-size:0.8rem;font-weight:600;margin-bottom:16px;">
                <i class="fa-solid fa-flask"></i> Đang chạy SePay sandbox
            </div>
        }

        <div style="display: inline-block; padding: 16px; background: #fff; border: 2px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-sm); margin-bottom: 22px;">
            <img src="@ViewBag.QrUrl" alt="SePay QR" style="width: 280px; height: auto; border-radius: 8px;" />
        </div>

        <div style="background: var(--bg-body); border-radius: 16px; padding: 20px; max-width: 480px; margin: 0 auto 20px; text-align: left; font-size: 0.92rem; line-height: 1.9;">
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Mã đơn hàng:</span>
                <strong>@Model.OrderCode</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Số tiền:</span>
                <strong style="color: var(--primary); font-size: 1.1rem;">@Model.TotalAmount.ToString("N0") đ</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Ngân hàng:</span>
                <strong>@ViewBag.Bank</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Số tài khoản:</span>
                <strong>@ViewBag.AccountNumber</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Chủ tài khoản:</span>
                <strong>@ViewBag.AccountHolder</strong>
            </div>
            <div style="display: flex; justify-content: space-between; gap: 10px;">
                <span style="color: var(--text-muted); white-space: nowrap;">Nội dung CK:</span>
                <strong style="color: #005030; text-align: right;">@ViewBag.TransferContent</strong>
            </div>
        </div>

        <div id="sepayStatusBox" style="max-width: 480px; margin: 0 auto 20px; padding: 14px 18px; border-radius: 12px; font-weight: 600; font-size: 0.92rem; background: #fffbeb; color: #92400e; border: 1px solid #fcd34d;">
            <i class="fa-solid fa-hourglass-half"></i>
            <span>Đang chờ SePay xác nhận chuyển khoản…</span>
        </div>

        <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
            <a id="sepaySuccessLink" href="@Url.Action("Success", "Payment", new { orderCode = Model.OrderCode })"
               class="btn btn-primary" style="display: none;">
                <i class="fa-solid fa-check"></i> Xem đơn hàng
            </a>
            <a href="/tra-cuu-don-hang?orderCode=@Model.OrderCode&phone=@Model.SenderPhone" class="btn btn-secondary">
                Kiểm tra tiến độ đơn
            </a>
        </div>

        <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 16px;">
            Đã chuyển khoản nhưng chưa thấy cập nhật? Gọi hotline <strong>0377 415 147</strong> để tiệm đối chiếu.
        </p>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var orderCode = '@Model.OrderCode';
            var box = document.getElementById('sepayStatusBox');
            var successLink = document.getElementById('sepaySuccessLink');
            if (!box) return;

            var attempts = 0;
            var maxAttempts = 60; // ~8 phút, 8s/lần

            function renderPaid() {
                box.style.background = '#ecfdf5';
                box.style.color = '#065f46';
                box.style.borderColor = '#a7f3d0';
                box.innerHTML = '<i class="fa-solid fa-circle-check"></i> <span>SePay đã xác nhận thanh toán. Tiệm đang chuẩn bị hoa cho bạn!</span>';
                if (successLink) successLink.style.display = 'inline-flex';
            }

            function poll() {
                attempts++;

                fetch('/Payment/Status?orderCode=' + encodeURIComponent(orderCode), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data && data.success && data.isPaid) {
                            renderPaid();
                            return;
                        }

                        if (attempts >= maxAttempts) {
                            box.innerHTML = '<i class="fa-solid fa-circle-info"></i> <span>Chưa nhận được xác nhận. Nếu đã chuyển khoản, vui lòng gọi 0377 415 147.</span>';
                            return;
                        }

                        setTimeout(poll, 8000);
                    })
                    .catch(function () {
                        if (attempts < maxAttempts) setTimeout(poll, 12000);
                    });
            }

            setTimeout(poll, 7000);
        })();
    </script>
}
