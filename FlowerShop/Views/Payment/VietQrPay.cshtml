@model FlowerShop.Models.Entities.Order
@{
    ViewBag.Title = "Thanh Toán Chuyển Khoản VietQR - Hữu Phước Florist";
}

<div class="section" style="padding-top: 50px; max-width: 800px; text-align: center;">
    <div style="background: #fff; border: 1px solid var(--border); border-radius: 24px; padding: 40px; box-shadow: var(--shadow-md);">
        <div style="width: 70px; height: 70px; border-radius: 50%; background: #e8f5e9; color: #2e7d32; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 20px;">
            <i class="fa-solid fa-qrcode"></i>
        </div>

        <h1 class="font-serif" style="font-size: 2rem; margin-bottom: 8px;">Quét Mã VietQR Thanh Toán</h1>
        <p style="color: var(--text-muted); margin-bottom: 24px;">Mở bất kỳ ứng dụng ngân hàng hoặc ví điện tử để quét mã tự động chuyển khoản chính xác số tiền.</p>

        <!-- Dynamic VietQR Image -->
        <div style="display: inline-block; padding: 16px; background: #fff; border: 2px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-sm); margin-bottom: 24px;">
            <img src="@ViewBag.QrCodeUrl" alt="VietQR Payment" style="width: 280px; height: auto; border-radius: 8px;" />
        </div>

        <!-- Bank Details Box -->
        <div style="background: var(--bg-body); border-radius: 16px; padding: 20px; max-width: 480px; margin: 0 auto 28px; text-align: left; font-size: 0.92rem; line-height: 1.8;">
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Mã đơn hàng:</span>
                <strong>@Model.OrderCode</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Số tiền cần chuyển:</span>
                <strong style="color: var(--primary); font-size: 1.1rem;">@Model.TotalAmount.ToString("N0") đ</strong>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <span style="color: var(--text-muted);">Nội dung chuyển khoản:</span>
                <strong style="color: #005030;">THANH TOAN @Model.OrderCode</strong>
            </div>
        </div>

        <div style="display: flex; gap: 14px; justify-content: center;">
            <a href="@Url.Action("Success", "Payment", new { orderCode = Model.OrderCode })" class="btn btn-primary">
                <i class="fa-solid fa-check"></i> Tôi Đã Chuyển Khoản Thành Công
            </a>
            <a href="/tra-cuu-don-hang?orderCode=@Model.OrderCode" class="btn btn-secondary">
                Kiểm Tra Tiến Độ Đơn
            </a>
        </div>
    </div>
</div>
