@model List<FlowerShop.Models.Entities.Voucher>
@{
    ViewBag.Title = "Quản Lý Mã Ưu Đãi Voucher - Admin";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <h1 class="font-serif" style="font-size: 1.8rem; margin: 0; color: var(--admin-dark);">Quản Lý Mã Giảm Giá & Voucher</h1>
        <p style="color: var(--admin-text-muted); font-size: 0.95rem; margin-top: 4px;">Danh sách các mã khuyến mãi áp dụng trên website.</p>
    </div>
    <a href="/Admin/Voucher/Create" class="btn btn-primary btn-sm">
        <i class="fa-solid fa-plus"></i> Tạo Mã Voucher Mới
    </a>
</div>

<div class="admin-card-box">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã Code</th>
                    <th>Mô Tả</th>
                    <th>Mức Giảm</th>
                    <th>Đơn Tối Thiểu</th>
                    <th>Hạn Dùng</th>
                    <th>Đã Dùng / Giới Hạn</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><strong style="color: var(--admin-primary); font-size: 1rem;">@v.Code</strong></td>
                        <td>@v.Description</td>
                        <td>
                            @if (v.DiscountPercent.HasValue)
                            {
                                <span style="font-weight: 700; color: #2e7d32;">@v.DiscountPercent% (tối đa @((v.MaxDiscountAmount ?? 0).ToString("N0")) đ)</span>
                            }
                            else
                            {
                                <span style="font-weight: 700; color: #2e7d32;">@((v.DiscountAmount ?? 0).ToString("N0")) đ</span>
                            }
                        </td>
                        <td>@v.MinOrderValue.ToString("N0") đ</td>
                        <td>@(v.EndDate.HasValue ? v.EndDate.Value.ToString("dd/MM/yyyy") : "Vô thời hạn")</td>
                        <td>@v.UsedCount / @v.UsageLimit</td>
                        <td>
                            <span class="status-pill @(v.IsActive ? "pill-delivered" : "pill-cancelled")">
                                @(v.IsActive ? "Hoạt Động" : "Tạm Dừng")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
