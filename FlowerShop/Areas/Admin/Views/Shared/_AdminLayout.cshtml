<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Quản Trị Hệ Thống Shop Hoa - Bloom & Grace")</title>

    <!-- Google Fonts & FontAwesome 6 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Admin Stylesheet -->
    <link rel="stylesheet" href="~/Content/css/admin.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="admin-body">
    <!-- 1. Admin Sidebar -->
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <i class="fa-solid fa-spa"></i>
            <h2>Bloom & Grace</h2>
        </div>

        <ul class="admin-menu">
            <li>
                <a href="/Admin/Dashboard" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fa-solid fa-chart-pie"></i> Tổng Quan (Dashboard)
                </a>
            </li>
            <li>
                <a href="/Admin/Order" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                    <i class="fa-solid fa-boxes-packing"></i> Quản Lý Đơn & Điều Phối
                </a>
            </li>
            <li>
                <a href="/Admin/Product" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">
                    <i class="fa-solid fa-fan"></i> Danh Mục & Mẫu Hoa
                </a>
            </li>
            <li>
                <a href="/Admin/Voucher" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Voucher" ? "active" : "")">
                    <i class="fa-solid fa-ticket"></i> Mã Giảm Giá & Flash Sale
                </a>
            </li>
            <li>
                <a href="/Admin/Settings" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                    <i class="fa-solid fa-sliders"></i> Cấu Hình VNPay / Stripe / AI
                </a>
            </li>
            <li style="margin-top: auto;">
                <a href="/" target="_blank" style="color: #ffd4dc;">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Xem Cửa Hàng (Store)
                </a>
            </li>
        </ul>
    </aside>

    <!-- 2. Admin Main Wrapper -->
    <div class="admin-main">
        <!-- Topbar -->
        <header class="admin-topbar">
            <div style="font-weight: 700; font-size: 1.1rem; color: var(--admin-dark);">
                Hệ Thống Quản Trị Cửa Hàng Hoa Tươi & Quà Tặng
            </div>
            <div style="display: flex; align-items: center; gap: 18px;">
                <span style="font-size: 0.88rem; color: var(--admin-text-muted);">
                    <i class="fa-solid fa-circle" style="color: #10b981; font-size: 0.65rem; margin-right: 4px;"></i> Online
                </span>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover;" />
                    <span style="font-weight: 600; font-size: 0.9rem;">Quản Lý Cửa Hàng</span>
                </div>
            </div>
        </header>

        <!-- Dynamic Content Body -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>
