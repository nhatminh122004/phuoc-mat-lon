@model List<FlowerShop.Models.Entities.Order>
@{
    ViewBag.Title = "Quản Lý Đơn Hàng & Điều Phối Cắm Hoa - Admin";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <div>
        <h1 class="font-serif" style="font-size: 1.8rem; margin: 0; color: var(--admin-dark);">Quản Lý Đơn Hàng & Điều Phối</h1>
        <p style="color: var(--admin-text-muted); font-size: 0.95rem; margin-top: 4px;">Xem danh sách đơn, phân công thợ cắm hoa, duyệt ảnh thực tế và điều phối shipper.</p>
    </div>
</div>

<!-- Filter Tabs by Status -->
<div style="display: flex; gap: 8px; margin-bottom: 24px; overflow-x: auto; padding-bottom: 6px;">
    <a href="/Admin/Order" class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "btn-primary" : "btn-secondary")">Tất Cả (@Model.Count)</a>
    <a href="/Admin/Order?status=Pending" class="btn btn-sm @(ViewBag.CurrentStatus == "Pending" ? "btn-primary" : "btn-secondary")">Chờ Xác Nhận</a>
    <a href="/Admin/Order?status=Confirmed" class="btn btn-sm @(ViewBag.CurrentStatus == "Confirmed" ? "btn-primary" : "btn-secondary")">Đã Xác Nhận</a>
    <a href="/Admin/Order?status=Arranging" class="btn btn-sm @(ViewBag.CurrentStatus == "Arranging" ? "btn-primary" : "btn-secondary")">Đang Cắm Hoa</a>
    <a href="/Admin/Order?status=Shipping" class="btn btn-sm @(ViewBag.CurrentStatus == "Shipping" ? "btn-primary" : "btn-secondary")">Đang Giao Hàng</a>
    <a href="/Admin/Order?status=Delivered" class="btn btn-sm @(ViewBag.CurrentStatus == "Delivered" ? "btn-primary" : "btn-secondary")">Đã Giao Thành Công</a>
</div>

<div class="admin-card-box">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã Đơn</th>
                    <th>Người Gửi</th>
                    <th>Người Nhận & Địa Chỉ</th>
                    <th>Ngày & Giờ Giao</th>
                    <th>Tổng Tiền</th>
                    <th>Thanh Toán</th>
                    <th>Ảnh Thực Tế</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" style="text-align: center; color: #888; padding: 40px;">Không tìm thấy đơn hàng nào phù hợp với bộ lọc.</td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td>
                                <strong>@order.OrderCode</strong>
                                @if (order.IsAnonymous)
                                {
                                    <span style="display: block; font-size: 0.72rem; color: #c84b61;"><i class="fa-solid fa-mask"></i> Ẩn danh</span>
                                }
                            </td>
                            <td>
                                <div>@order.SenderName</div>
                                <div style="font-size: 0.8rem; color: #888;">@order.SenderPhone</div>
                            </td>
                            <td>
                                <div><strong>@order.RecipientName</strong></div>
                                <div style="font-size: 0.8rem; color: #888; max-width: 200px; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;">@order.RecipientAddress</div>
                            </td>
                            <td>
                                <div>@order.DeliveryDate.ToString("dd/MM/yyyy")</div>
                                <div style="font-size: 0.8rem; color: #c84b61; font-weight: 600;">@order.DeliveryTimeSlot</div>
                            </td>
                            <td>
                                <strong>@order.TotalAmount.ToString("N0") đ</strong>
                            </td>
                            <td>
                                <span class="status-pill @(order.PaymentStatus == "Paid" ? "pill-delivered" : "pill-pending")">@order.PaymentMethod (@order.PaymentStatus)</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(order.ProofPhotoUrl))
                                {
                                    <span style="color: #2e7d32; font-size: 0.85rem; font-weight: 600;"><i class="fa-solid fa-image"></i> Đã có ảnh</span>
                                }
                                else
                                {
                                    <span style="color: #888; font-size: 0.85rem;"><i class="fa-regular fa-image"></i> Chưa chụp</span>
                                }
                            </td>
                            <td>
                                @{
                                    string pillClass = "pill-pending";
                                    if (order.OrderStatus == "Confirmed") pillClass = "pill-confirmed";
                                    if (order.OrderStatus == "Arranging") pillClass = "pill-arranging";
                                    if (order.OrderStatus == "Shipping") pillClass = "pill-shipping";
                                    if (order.OrderStatus == "Delivered") pillClass = "pill-delivered";
                                }
                                <span class="status-pill @pillClass">@order.OrderStatus</span>
                            </td>
                            <td>
                                <a href="/Admin/Order/Details/@order.Id" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 0.8rem;">Xử Lý</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
