<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!-- Chuỗi kết nối MySQL Server. Cập nhật uid và password theo môi trường máy chủ của bạn -->
    <add name="FlowerShopConnectionString" 
         connectionString="server=localhost;port=3306;database=FlowerShopDb;uid=root;password=;CharSet=utf8mb4;SslMode=none;" 
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- Cấu hình Cổng Thanh Toán VNPay Sandbox -->
    <add key="Vnpay:BaseUrl" value="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html" />
    <add key="Vnpay:TmnCode" value="DEMOSHOP" />
    <add key="Vnpay:HashSecret" value="SECRETKEY1234567890ABCDEF" />
    <add key="Vnpay:ReturnUrl" value="http://localhost:5000/Payment/VnpayReturn" />

    <!-- Cấu hình Cổng Thanh Toán Stripe Elements -->
    <add key="Stripe:PublishableKey" value="pk_test_TYoo61E7ZXqStWST8qjekqqQ" />
    <add key="Stripe:SecretKey" value="sk_test_your_stripe_secret_key_here" />

    <!-- Cấu hình Cổng Thanh Toán VietQR Tự Động (NAPAS 24/7) -->
    <add key="VietQR:BankId" value="MB" />
    <add key="VietQR:AccountNo" value="0909123456888" />
    <add key="VietQR:AccountName" value="TIEM HOA FLOWER BOUTIQUE" />

    <!-- Cấu hình Chatbot AI -->
    <add key="Chatbot:GeminiApiKey" value="" />
    <add key="Chatbot:FloristName" value="Hương Lan" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="1048576" />
    <sessionState mode="InProc" timeout="60" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="vi-VN" uiCulture="vi-VN" />
  </system.web>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="MySql.Data" publicKeyToken="c5687fc88969c44d" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.33.0" newVersion="8.0.33.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <system.data>
    <DbProviderFactories>
      <remove invariant="MySql.Data.MySqlClient" />
      <add name="MySQL Data Provider" invariant="MySql.Data.MySqlClient" description=".Net Framework Data Provider for MySQL" type="MySql.Data.MySqlClient.MySqlClientFactory, MySql.Data, Version=8.0.33.0, Culture=neutral, PublicKeyToken=c5687fc88969c44d" />
    </DbProviderFactories>
  </system.data>

  <entityFramework>
    <providers>
      <provider invariantName="MySql.Data.MySqlClient" type="MySql.Data.MySqlClient.MySqlProviderServices, MySql.Data.EntityFramework, Version=8.0.33.0, Culture=neutral, PublicKeyToken=c5687fc88969c44d" />
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
